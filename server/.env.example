# Copy file ini menjadi .env dan isi nilainya

# MongoDB Atlas connection string
# Dapetin dari: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio-db?retryWrites=true&w=majority

# JWT Secret — buat string acak panjang, jangan dibagikan!
# Generator: https://www.allkeysgenerator.com/Random/Security-Encryption-Key-Generator.aspx
JWT_SECRET=ganti_dengan_string_acak_sangat_panjang_minimal_64_karakter

# Password admin untuk login ke dashboard
ADMIN_PASSWORD=password_admin_kamu_yang_kuat

# Port server (default 5000)
PORT=5000

# URL frontend (untuk CORS whitelist)
# Development: http://localhost:3000
# Production: https://portfolio-kamu.vercel.app
FRONTEND_URL=http://localhost:3000
